# ===========================================
# vikunja Configuration
# ===========================================

# --- Docker Images ---
# Pin to specific digest for reproducibility:
# Example: upstream/image:tag@sha256:<digest>
SERVICE_IMAGE=ghcr.io/korjavin/vikunja-vendor:latest
POSTGRES_IMAGE=postgres:16-alpine

# --- Container Names ---
SERVICE_CONTAINER_NAME=vikunja
DB_CONTAINER_NAME=vikunja-db

# --- Network Names ---
TRAEFIK_NETWORK_NAME=traefik_default
INTERNAL_NETWORK_NAME=vikunja_internal

# --- Volume Names ---
DB_VOLUME_NAME=vikunja_db-data
FILES_VOLUME_NAME=vikunja_files

# --- Traefik Configuration ---
SERVICE_HOST=vikunja.yourdomain.com
TRAEFIK_CERTRESOLVER=myresolver

# --- Required Secrets ---
# Generate with: openssl rand -hex 32
VIKUNJA_SERVICE_SECRET=change-me
VIKUNJA_SERVICE_PUBLICURL=https://vikunja.yourdomain.com

# --- Database ---
POSTGRES_DB=vikunja
POSTGRES_USER=vikunja
POSTGRES_PASSWORD=change-me-to-strong-password
